	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>






	<script src="~/js/jquery-3.6.4.min.js" asp-append-version="true"></script>
	<script src="~/js/bootstrap.bundle.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/&#64;fingerprintjs/fingerprintjs@3/dist/fp.min.js"></script>
	<script>
			  document.addEventListener("DOMContentLoaded", function () {
				  const loginBtn = document.getElementById("loginButton");

				  if (loginBtn) {
					  loginBtn.addEventListener("click", async function (event) {
						  event.preventDefault();
		
						  const username = $('#txtusername').val().trim();
						  const password = $('#txtpassword').val().trim();

							if (!username || !password) {
								Swal.fire({
									icon: 'warning',
									title: 'Validation Error',
									text: 'Username and password are required.',
									allowOutsideClick: false,
									backdrop: true,          
									confirmButtonText: 'OK'  
								});
								return;
							}

						  $.ajax({
							  type: "POST",
							  url: "/api/login",
							  data: {
								  username: username,
								  password: password
							  },
							  success: function (response) {
								  if (response.token) {
										sessionStorage.setItem("tenantid", response.token);
										if(response.redirectURL)
										{
											let cleanUrl = response.redirectURL.split('?')[0];
											if (response.details) {
												  sessionStorage.setItem("companyName", response.details.name);
												  sessionStorage.setItem("regId", response.details.regno);
												  sessionStorage.setItem("expiryDate", response.details.expiry);
												  sessionStorage.setItem("email", response.details.mail);
												  sessionStorage.setItem("place", response.details.place);
												  sessionStorage.setItem("country", response.details.country);
											  }
											window.location.href = cleanUrl;

											// window.location.href = response.redirectURL;
											return;
										}
										document.getElementById('loginSection').classList.add('hidden');
										document.getElementById('keypadboard').classList.add('hidden');
										document.getElementById('otpSection').classList.add('visible');
								  } else {
									  resetLoginButton();
									  Swal.fire({
										  icon: 'info',
										  title: response.redirectUrl,
										  text: response.message,
										  allowOutsideClick: false,
									      backdrop: true,
									  });
								  }
							  },
								error: function (xhr) {
									resetLoginButton();

									if (xhr.status === 409) {
										let errorMessage = "Account is locked.";

										try {
											const response = JSON.parse(xhr.responseText);
											errorMessage = response.message || errorMessage;
										} catch (e) {
											console.error("Failed to parse error response", e);
										}

										Swal.fire({
											icon: 'info',
											title: 'Login Failed',
											text: errorMessage,
											allowOutsideClick: false,
											backdrop: true,
										});
									} else {
										Swal.fire({
											icon: 'info',
											title: 'Server Error',
											text: 'Please try again later.',
											allowOutsideClick: false,
											backdrop: true,
										});
									}
								}

						  });
					  });
				  }
			  });
	</script>

	<script>
		function resetLoginButton() {
			const loginButton = document.getElementById("loginButton");
			const spinner = document.getElementById("loadingSpinner");
			const loginText = document.getElementById("loginText");

			loginButton.disabled = false;
			loginText.textContent = "Log In";
			spinner.classList.add("d-none");
		}

		function resetVerifyOtpButton() {
			const otpButton = document.getElementById("verifyOtpButton");
			const spinner = document.getElementById("otpLoadingSpinner");
			const text = document.getElementById("otpButtonText");

			otpButton.disabled = false;
			text.textContent = "Verify OTP";
			spinner.classList.add("d-none");
		}


		let focusedInput = null;

		// Store the last focused input field
		document.addEventListener('focusin', function (event) {
			if (event.target.tagName === 'INPUT' && event.target.type === 'text' || event.target.type === 'password') {
				focusedInput = event.target;
			}
		});

		function appendNumber(num) {
			if (focusedInput) {
				focusedInput.value += num;
				focusedInput.focus();
			}
		}

		function clearRegister() {
			if (focusedInput) {
				focusedInput.value = '';
				focusedInput.focus();
			}
		}

		function backspace() {
			if (focusedInput) {
				focusedInput.value = focusedInput.value.slice(0, -1);
				focusedInput.focus();
			}
		}
	</script>

	<script>
		$(document).ready(function () {
			$('#togglePassword').on('click', function () {
				let passwordInput = $('#txtpassword');
				let icon = $('#eyeIcon');
				let type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
				passwordInput.attr('type', type);
				icon.toggleClass('bi-eye-slash bi-eye');
			});
		});

		$('#otpInput').on('keypress', function (e) {
			if (e.which === 13) {
				$('#verifyOtpButton').click();
			}
		});

		function isValidOtp(otp) {
		  return /^\d{6}$/.test(otp);
		}

		document.getElementById('verifyOtpButton').addEventListener('click', async () => {
			const otpInput = document.getElementById('otpInput');
			const otp = otpInput.value;

			const sessionId = sessionStorage.getItem("tenantid");

			if (!sessionId) {
				resetLoginButton();
				resetVerifyOtpButton();
				Swal.fire({
					icon: 'info',
					title: 'Session Interrupted',
					text: 'We noticed something unusual. Please log in again to continue.',
					confirmButtonText: 'OK'
				}).then(() => {
					window.location.href = '/home';
				});
				return;
			}

			// Validate OTP input
			if (!/^\d{6}$/.test(otp)) {
				resetVerifyOtpButton();
				Swal.fire({
					icon: 'info',
					title: 'Invalid OTP',
					text: 'Please enter a valid 6-digit numeric OTP.',
					allowOutsideClick: false,
					backdrop: true,
				});
				//otpInput.focus();
				return;
			}



		$.ajax({
			type: "POST",
			url: "/api/verifyotp",
			data: {
				otp: otp,
				sessionId: sessionId
			},
			success: async function (response) {
				if (response.token && response.redirectUrl) {
					sessionStorage.setItem("redirectURL", response.redirectUrl);
					if (response.details) {
						sessionStorage.setItem("companyName", response.details.name);
						sessionStorage.setItem("regId", response.details.regno);
						sessionStorage.setItem("expiryDate", response.details.expiry);
						sessionStorage.setItem("email", response.details.mail);
						sessionStorage.setItem("place", response.details.place);
						sessionStorage.setItem("country", response.details.country);
					}
		try {
			let ipData = {};
			let location = {};
			let deviceInfo = {};

			// Fetch IP-based geolocation
			try {
				const ipResponse = await fetch('https://ipapi.co/json/');
				ipData = await ipResponse.json();
			} catch (geoError) {
				const ipRes = await fetch('https://ipinfo.io/json?token=72730f231e601c'); // Replace with actual token
				ipData = await ipRes.json();
				const [lat, lon] = ipData.loc.split(',');
				ipData.latitude = parseFloat(lat);
				ipData.longitude = parseFloat(lon);
			}

			location = {
				latitude: ipData.latitude,
				longitude: ipData.longitude,
				source: "IP"
			};

			// Detect browser name
			const getBrowserName = async () => {
				const ua = navigator.userAgent;
				if (navigator.brave && typeof navigator.brave.isBrave === 'function' && await navigator.brave.isBrave()) return "Brave";
				if (ua.includes("Edg")) return "Edge";
				if (ua.includes("OPR") || ua.includes("Opera")) return "Opera";
				if (ua.includes("Chrome")) return "Chrome";
				if (ua.includes("Firefox")) return "Firefox";
				if (ua.includes("Safari")) return "Safari";
				if (ua.includes("Trident") || ua.includes("MSIE")) return "Internet Explorer";
				return "Unknown";
			};

			const getDeviceType = () => {
				const ua = navigator.userAgent;
				const width = window.innerWidth;
				if (/Mobi|Android/i.test(ua)) return "Phone";
				if (/Tablet|iPad/i.test(ua) || (width >= 768 && width <= 1024)) return "Tablet";
				if (width >= 1025 && width <= 1366) return "Laptop";
				return "Desktop";
			};

			const browserName = await getBrowserName();
			const deviceType = getDeviceType();

			deviceInfo = {
				platform: navigator.platform,
				userAgent: navigator.userAgent,
				language: navigator.language,
				browser: browserName
			};

			// Load fingerprint
			const fp = await FingerprintJS.load();
			const result = await fp.get();

			// Compose metadata object
			const metadata = {
				ip: ipData.ip,
				city: ipData.city,
				region: ipData.region,
				country_name: ipData.country_name || 'Not found',
				latitude: ipData.latitude,
				longitude: ipData.longitude,
				timezone: ipData.timezone,
				platform: deviceInfo.platform,
				userAgent: deviceInfo.userAgent,
				language: deviceInfo.language,
				browser: deviceInfo.browser,
				visitorId: result.visitorId,
				vendor: navigator.vendor,
				renderer: (navigator.gpu || {}).adapter || "Unavailable",
				screenResolution: `${screen.width}x${screen.height}`,
				localstorage: !!window.localStorage,
				sessionStorage: !!window.sessionStorage,
				cookie: navigator.cookieEnabled,
				deviceType: deviceType
			};
		$.ajax({
			type: "POST",
			url: "/api/log",
			data: JSON.stringify(metadata),
			contentType: "application/json",
			success: function (res) {
				window.location.href = response.redirectUrl;
			},
			error: function (xhr, status, error) {
				resetVerifyOtpButton();
				Swal.fire({
					icon: 'warning',
					title: 'Oops!',
					text: 'Something went wrong. Please try again.'
				});
			}
		});

		} catch (err) {
			resetVerifyOtpButton();
			Swal.fire({
				icon: 'warning',
				title: 'Oops!',
				text: 'Something went wrong. Please try again.'
			});
		}

				} else {
					// Clear OTP input field and show error
					$('#otpInput').val('');
					resetVerifyOtpButton();
					const response = JSON.parse(err.responseText);
					errorMessage = response.message || errorMessage;
					Swal.fire({
						icon: 'info',
						title: 'Authentication Error',
						text: 'Invalid OTP. Please try again.'
					});
				}
			},
		error: function (xhr, status, error) {
			// Clear OTP input field
			$('#otpInput').val('');

			let icon = 'error';
			let title = 'Authentication Error';
			let message = 'Something went wrong. Please try again later.';

			try {
				const responseJson = JSON.parse(xhr.responseText);

				if (xhr.status === 409) {
					icon = 'info';
					title = 'Invalid OTP';
					message = responseJson.message || 'Invalid OTP. Please try again.';
				} else if (xhr.status === 429) {
					icon = 'info';
					title = 'Account Locked';
					message = responseJson.message || 'Too many failed attempts. Please contact administrator.';
				}
			} catch (e) {
				// Fallback message if parsing fails
				if (xhr.status === 409) {
					icon = 'info';
					title = 'Invalid OTP';
					message = 'Invalid OTP. Please try again.';
				} else if (xhr.status === 429) {
					icon = 'info';
					title = 'Account Locked';
					message = 'Too many failed attempts. Please contact administrator.';
				}
			}

			resetVerifyOtpButton();

			Swal.fire({
				icon: icon,
				title: title,
				text: message,
				allowOutsideClick: false,
				backdrop: true
			});
		}


		});



		});
	</script>
	<script>
		$(document).ready(function() {
			const urlParams = new URLSearchParams(window.location.search);
			if (urlParams.get('sessionExpired') === 'true') {
				resetLoginButton();
				Swal.fire({
					icon: 'info',
					title: 'Session Expired',
					text: 'Please log in again to continue working.',
					confirmButtonText: 'Log In'
				});
			}
			if (urlParams.get('lockedOut') === 'true') {
				resetLoginButton();
			Swal.fire({
				icon: 'error',
				title: 'Account Locked',
				text: 'Too many failed login attempts. Please contact administrator to unblock your account.',
				confirmButtonText: 'OK'
			});
		}
		});
	</script>

	<!-- JAVASCRIPT -->
	<script src="~/js/waves.min.js"></script>



</body>
</html>
