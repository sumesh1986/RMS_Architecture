	<link href="~/css/site.css" rel="stylesheet" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
	<link href="~/css/metismenu.min.css" rel="stylesheet" />
	<link href="~/css/metismenujs.css" rel="stylesheet" />

	<style>
		/* Arrow for MetisMenu items */
		.metismenu .::after {
			font-family: 'bootstrap-icons';
			content: "\f285"; /* bi-chevron-right */
			float: right;
			font-size: 0.8rem;
			transition: transform 0.3s ease;
			line-height: 1;
		}

		/* Rotate arrow when menu is active/open */
		.metismenu .mm-active > a.::after {
			transform: rotate(90deg);
		}

		body .toast {
			opacity: 1 !important; /* Enforce opacity */
			transition: none !important; /* Disable fade effects */
		}

		.toast-success {
			/*border: 2px solid rgba(255, 255, 255, 0.65) !important;*/
			border: none;
			background-color: #009E61 !important; /* Green */
		}

		.toast-error {
			/* border: 2px solid rgba(255, 255, 255, 0.65) !important; */
			border: none;
			background-color: #C63100 !important; /* Red */
		}

		.toast-warning {
/* 			border: 2px solid rgba(255, 255, 255, 0.65) !important;
 */			border: none;
			background-color: #FFC254 !important; /* Yellow */
		}

		.toast-info {
			/*border: 2px solid rgba(255, 255, 255, 0.65) !important;*/
			border: none;
			background-color: #1673F5 !important; /* Green */
		}

		.menu-section-highlight {
			border-top: 1px solid #dee2e6;
			border-bottom: 1px solid #dee2e6;
			padding-top: 5px;
			padding-bottom: 5px;
			margin-top: 8px;
			margin-bottom: 8px;
			background-color: #f8f9fa; /* Optional: subtle background */
			border-radius: 4px; /* Optional: rounded feel */
		}

			.menu-section-highlight:hover {
				background-color: #e9ecef;
			}

		.menu-highlight-top {
			border-top: 2px solid #dee2e66b; /* Bootstrap primary color or your preferred highlight color */
		}

		.menu-highlight-bottom {
			border-bottom: 2px solid #dee2e66b;
		}

		.sidebar-footer {
			position: absolute;
			bottom: 0;
			width: 100%;
			background-color: #ffffff; /* or match your theme */
		}

		.vertical-menu > div[data-simplebar] {
			padding-bottom: 100px; /* To avoid content overlap with footer */
			position: relative;
		}

		.text-avatar {
			width: 40px; /* same size as your image */
			height: 40px;
			background-color: #007bff; /* premium blue, adjust to brand */
			color: white;
			font-weight: 600;
			font-size: 20px;
			display: flex;
			align-items: center;
			justify-content: center;
			user-select: none;
			text-transform: uppercase;
			cursor: default;
		}

	</style>


	@RenderSection("Styles", required: false)
</head>
